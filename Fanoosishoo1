<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="فانوسی شو - تراپی و گذار آبرومندانه از مشکلات + تبلیغات دیجیتال با هوش مصنوعی">
    <title>فانوسی شو | نور درون، درخشش بیرون</title>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-light: #f4e5c2;
            --gold-dark: #b8941f;
            --cyan-primary: #00d4ff;
            --cyan-dark: #0099cc;
            --dark-bg: #0a0a0a;
            --card-bg: rgba(20, 20, 20, 0.8);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background: var(--dark-bg);
            color: #fff;
            overflow-x: hidden;
            line-height: 1.8;
        }

        /* Preloader */
        .preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--dark-bg);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

        .preloader.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .preloader-lantern {
            width: 100px;
            animation: preloaderPulse 1.5s ease-in-out infinite;
            filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.6));
        }

        @keyframes preloaderPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.8; }
        }

        /* Background */
        .bg-gradient {
            position: fixed;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(0, 212, 255, 0.05) 0%, transparent 50%);
            z-index: -2;
        }

        .bg-grid {
            position: fixed;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(212, 175, 55, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
            background-size: 100px 100px;
            z-index: -1;
        }

        /* Navigation */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(10, 10, 10, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
            transition: all 0.3s ease;
        }

        .navbar.scrolled {
            padding: 1rem 5%;
            background: rgba(10, 10, 10, 0.95);
        }

        .nav-logo {
            font-size: 1.8rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            right: 0;
            width: 0;
            height: 2px;
            background: var(--gold-primary);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-links a:hover {
            color: var(--gold-primary);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--gold-primary);
            font-size: 1.5rem;
            cursor: pointer;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 8rem 2rem 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero-badge {
            display: inline-block;
            padding: 0.6rem 2rem;
            background: rgba(212, 175, 55, 0.15);
            border: 2px solid var(--gold-primary);
            border-radius: 50px;
            color: var(--gold-primary);
            font-size: 1rem;
            margin-bottom: 2rem;
            animation: fadeInDown 1s ease;
            font-weight: 700;
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 900;
            text-align: center;
            margin-bottom: 1rem;
            line-height: 1.2;
            animation: fadeInUp 1s ease 0.2s both;
        }

        .hero-title span {
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-light) 50%, var(--gold-primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            background-size: 200% auto;
            animation: shine 3s linear infinite;
        }

        .hero-subtitle {
            font-size: 1.3rem;
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
            margin-bottom: 1rem;
            max-width: 700px;
            animation: fadeInUp 1s ease 0.4s both;
            line-height: 2;
        }

        .hero-subtitle strong {
            display: block;
            margin: 0.5rem 0;
        }

        .gold-text { color: var(--gold-primary); }
        .cyan-text { color: var(--cyan-primary); }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        .hero-lantern {
            width: 280px;
            margin: 2.5rem 0;
            position: relative;
            animation: float 6s ease-in-out infinite, fadeIn 1s ease 0.6s both;
            filter: drop-shadow(0 0 60px rgba(212, 175, 55, 0.5));
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .cta-group {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 1s ease 0.8s both;
            max-width: 600px;
        }

        .btn {
            padding: 1.2rem 2.5rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1rem;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
            color: #000;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.6);
        }

        .btn-cyan {
            background: transparent;
            color: var(--cyan-primary);
            border: 2px solid var(--cyan-primary);
            box-shadow: 0 5px 20px rgba(0, 212, 255, 0.2);
        }

        .btn-cyan:hover {
            background: rgba(0, 212, 255, 0.1);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.4);
        }

        /* Stats Section */
        .stats {
            padding: 5rem 2rem;
            background: rgba(20, 20, 20, 0.6);
            border-top: 1px solid rgba(212, 175, 55, 0.2);
            border-bottom: 1px solid rgba(0, 212, 255, 0.2);
        }

        .stats-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 3rem;
            text-align: center;
        }

        .stat-item h3 {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            font-weight: 900;
        }

        .stat-item.gold h3 { color: var(--gold-primary); }
        .stat-item.cyan h3 { color: var(--cyan-primary); }

        .stat-item p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }

        /* Services Section */
        .services {
            padding: 6rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-header h2 {
            font-size: clamp(2rem, 4vw, 3rem);
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--gold-primary), var(--cyan-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 3rem;
        }

        .service-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 3rem 2rem;
            text-align: center;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .service-card.therapy {
            border: 2px solid rgba(212, 175, 55, 0.3);
            border-top: 5px solid var(--gold-primary);
        }

        .service-card.ai {
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-top: 5px solid var(--cyan-primary);
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .service-card.therapy::before {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
        }

        .service-card.ai::before {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), transparent);
        }

        .service-card:hover::before {
            opacity: 1;
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        }

        .service-card.therapy:hover {
            box-shadow: 0 20px 50px rgba(212, 175, 55, 0.3);
        }

        .service-card.ai:hover {
            box-shadow: 0 20px 50px rgba(0, 212, 255, 0.3);
        }

        .service-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 2rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #000;
        }

        .service-card.therapy .service-icon {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
        }

        .service-card.ai .service-icon {
            background: linear-gradient(135deg, var(--cyan-primary), var(--cyan-dark));
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.4);
        }

        .service-card h3 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
        }

        .service-card.therapy h3 { color: var(--gold-primary); }
        .service-card.ai h3 { color: var(--cyan-primary); }

        .service-card p {
            color: rgba(255, 255, 255, 0.8);
            line-height: 2;
            margin-bottom: 1.5rem;
        }

        .service-features {
            text-align: right;
            color: rgba(255, 255, 255, 0.8);
            line-height: 2.2;
            list-style: none;
            margin-bottom: 2rem;
        }

        .service-features li {
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            margin-bottom: 0.5rem;
        }

        .service-features i {
            margin-top: 0.3rem;
            font-size: 0.9rem;
        }

        .service-card.therapy .service-features i { color: var(--gold-primary); }
        .service-card.ai .service-features i { color: var(--cyan-primary); }

        /* Testimonials */
        .testimonials {
            padding: 6rem 2rem;
            background: rgba(20, 20, 20, 0.6);
        }

        .testimonials-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .testimonial-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 2.5rem;
            position: relative;
            transition: all 0.3s ease;
        }

        .testimonial-card.therapy {
            border-right: 4px solid var(--gold-primary);
        }

        .testimonial-card.ai {
            border-right: 4px solid var(--cyan-primary);
        }

        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .testimonial-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }

        .testimonial-card.therapy .testimonial-icon { color: var(--gold-primary); }
        .testimonial-card.ai .testimonial-icon { color: var(--cyan-primary); }

        .testimonial-text {
            color: rgba(255, 255, 255, 0.9);
            font-style: italic;
            line-height: 1.9;
            margin-bottom: 1.5rem;
        }

        .testimonial-author {
            font-weight: 700;
        }

        .testimonial-card.therapy .testimonial-author { color: var(--gold-primary); }
        .testimonial-card.ai .testimonial-author { color: var(--cyan-primary); }

        .testimonial-type {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 0.3rem;
        }

        /* FAQ Section */
        .faq {
            padding: 6rem 2rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .faq-grid {
            display: grid;
            gap: 2rem;
            margin-top: 3rem;
        }

        .faq-category {
            margin-bottom: 2rem;
        }

        .faq-category-title {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .faq-category.therapy .faq-category-title {
            color: var(--gold-primary);
            border-color: var(--gold-primary);
        }

        .faq-category.ai .faq-category-title {
            color: var(--cyan-primary);
            border-color: var(--cyan-primary);
        }

        .faq-item {
            background: var(--card-bg);
            border-radius: 16px;
            margin-bottom: 1rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .faq-item.therapy { border: 1px solid rgba(212, 175, 55, 0.2); }
        .faq-item.ai { border: 1px solid rgba(0, 212, 255, 0.2); }

        .faq-item:hover {
            transform: translateX(5px);
        }

        .faq-question {
            padding: 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            color: #fff;
        }

        .faq-question i {
            transition: transform 0.3s ease;
            font-size: 1.2rem;
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 0 1.5rem;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.9;
        }

        .faq-item.active .faq-answer {
            padding: 0 1.5rem 1.5rem;
            max-height: 300px;
        }

        /* Contact Section */
        .contact {
            padding: 6rem 2rem;
            background: rgba(20, 20, 20, 0.6);
            text-align: center;
        }

        .contact-box {
            max-width: 800px;
            margin: 0 auto;
            background: var(--card-bg);
            border: 2px solid rgba(212, 175, 55, 0.3);
            border-radius: 32px;
            padding: 3rem;
            box-shadow: 0 0 60px rgba(212, 175, 55, 0.15);
        }

        .contact h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--gold-primary), var(--cyan-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .contact > p {
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .contact-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-top: 2rem;
        }

        .contact-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 1.3rem;
            background: rgba(255, 255, 255, 0.03);
            border: 2px solid;
            border-radius: 16px;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.05rem;
            transition: all 0.3s ease;
        }

        .contact-link.whatsapp {
            border-color: #25d366;
        }

        .contact-link.whatsapp:hover {
            background: rgba(37, 211, 102, 0.1);
            box-shadow: 0 5px 20px rgba(37, 211, 102, 0.3);
            transform: translateY(-3px);
        }

        .contact-link.telegram {
            border-color: #0088cc;
        }

        .contact-link.telegram:hover {
            background: rgba(0, 136, 204, 0.1);
            box-shadow: 0 5px 20px rgba(0, 136, 204, 0.3);
            transform: translateY(-3px);
        }

        .contact-link.instagram {
            border-color: #e1306c;
        }

        .contact-link.instagram:hover {
            background: rgba(225, 48, 108, 0.1);
            box-shadow: 0 5px 20px rgba(225, 48, 108, 0.3);
            transform: translateY(-3px);
        }

        .contact-link.phone {
            border-color: var(--gold-primary);
        }

        .contact-link.phone:hover {
            background: rgba(212, 175, 55, 0.1);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.3);
            transform: translateY(-3px);
        }

        .contact-link i {
            font-size: 1.5rem;
        }

        /* Footer */
        footer {
            padding: 3rem 2rem;
            text-align: center;
            border-top: 1px solid rgba(212, 175, 55, 0.2);
            background: rgba(0, 0, 0, 0.5);
        }

        .footer-logo {
            font-size: 2.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold-primary), var(--cyan-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }

        .footer-tagline {
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }

        .footer-copy {
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.9rem;
        }

        /* Floating WhatsApp Button */
        .whatsapp-float {
            position: fixed;
            bottom: 30px;
            left: 30px;
            width: 65px;
            height: 65px;
            background: linear-gradient(135deg, #25d366, #128c7e);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2.2rem;
            box-shadow: 0 5px 25px rgba(37, 211, 102, 0.5);
            cursor: pointer;
            z-index: 999;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .whatsapp-float:hover {
            transform: translateY(-5px) scale(1.1);
            box-shadow: 0 10px 35px rgba(37, 211, 102, 0.7);
        }

        /* Scroll Animations */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .mobile-menu-btn {
                display: block;
            }

            .hero-title {
                font-size: 2rem;
            }

            .hero-lantern {
                width: 200px;
            }

            .cta-group {
                flex-direction: column;
                width: 100%;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }

            .testimonials-grid {
                grid-template-columns: 1fr;
            }

            .contact-box {
                padding: 2rem 1.5rem;
            }

            .contact-links {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Preloader -->
    <div class="preloader" id="preloader">
        <img src="logo.png" alt="Loading..." class="preloader-lantern">
    </div>

    <!-- Background -->
    <div class="bg-gradient"></div>
    <div class="bg-grid"></div>

    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="nav-logo">فانوسی شو</div>
        <ul class="nav-links">
            <li><a href="#home">صفحه اصلی</a></li>
            <li><a href="#services">خدمات</a></li>
            <li><a href="#testimonials">نظرات</a></li>
            <li><a href="#faq">سوالات</a></li>
            <li><a href="#contact">تماس</a></li>
        </ul>
        <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
            <i class="fas fa-bars"></i>
        </button>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-badge">
            <i class="fas fa-lightbulb"></i>
            نور درون، درخشش بیرون
        </div>
        
        <h1 class="hero-title">
            <span>فانوسی شو</span>
        </h1>
        
